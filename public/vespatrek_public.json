<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
  <title>VespaTrek — Live Map</title>

  <!-- Leaflet CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <style>
    :root {
      --bg: #121212;
      --card: #1e1e1e;
      --border: #333;
      --text: #fff;
      --brand: #2196F3;
      --accent: #ff9800;
      --yt: #ff0000;
      --fuel: #4caf50;
      --maint: #9c27b0;
      --carb: #00bcd4;
    }

    * { box-sizing: border-box; }
    body, html {
      margin: 0; padding: 0;
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      height: 100%;
      overflow: hidden; /* Tutto gestito internamente */
    }

    /* ===== HEADER E CONTROLLI ===== */
    #topBar {
      position: absolute;
      top: 0; left: 0; width: 100%;
      background: rgba(18, 18, 18, 0.9);
      backdrop-filter: blur(10px);
      z-index: 1000;
      padding: 10px;
      border-bottom: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .header-title {
      font-size: 20px;
      font-weight: 900;
      letter-spacing: 1px;
      color: var(--text);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .filters {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 5px;
    }
    .filters::-webkit-scrollbar { display: none; }

    .btn-filter {
      background: #333;
      border: 1px solid #555;
      color: #ccc;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: bold;
      white-space: nowrap;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-filter.active {
      background: var(--accent);
      color: #000;
      border-color: var(--accent);
    }
    .btn-filter.active-blue {
      background: var(--brand);
      color: #fff;
      border-color: var(--brand);
    }

    /* ===== MAPPA ===== */
    #mapPub {
      position: absolute;
      top: 90px; /* Spazio per la topbar */
      bottom: 0;
      width: 100%;
      z-index: 1;
    }

    /* ===== MARKERS PERSONALIZZATI ===== */
    .custom-marker {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 34px !important;
      height: 34px !important;
      border-radius: 50%;
      font-size: 18px;
      border: 2px solid #fff;
      box-shadow: 0 4px 10px rgba(0,0,0,0.6);
      margin-left: -17px !important;
      margin-top: -17px !important;
      color: #fff;
      z-index: 1000 !important;
    }
    .marker-foto { background: var(--accent); }
    .marker-video { background: var(--yt); font-size: 14px; }
    .marker-maint { background: var(--maint); }
    .marker-fuel  { background: var(--fuel); }
    .marker-carb  { background: var(--carb); }

    /* ===== POPUP LEAFLET ===== */
    .leaflet-popup-content-wrapper {
      background: var(--card);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .leaflet-popup-tip { background: var(--card); border: 1px solid var(--border); }
    .popup-title { font-weight: 900; color: var(--accent); margin-bottom: 5px; font-size: 16px; }
    .popup-meta { font-size: 12px; color: #aaa; margin-bottom: 8px; }
    .popup-img { width: 100%; border-radius: 8px; margin-top: 8px; cursor: pointer; }
    .popup-video iframe { width: 100%; height: 160px; border-radius: 8px; margin-top: 8px; border:none; }

    /* ===== LIGHTBOX FOTO ===== */
    #lightbox {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.95); z-index: 9999;
      align-items: center; justify-content: center;
    }
    #lightbox.open { display: flex; }
    #lightbox img { max-width: 95vw; max-height: 90vh; border-radius: 8px; }
    #lightboxClose {
      position: absolute; top: 15px; right: 15px;
      background: #f44336; color: #fff; border: none;
      width: 40px; height: 40px; border-radius: 50%;
      font-size: 20px; font-weight: bold; cursor: pointer;
    }
  </style>
</head>

<body>

  <!-- HEADER & FILTRI -->
  <div id="topBar">
    <div class="header-title">
      <span id="appTitle">VespaTrek Live 🌍</span>
      <span id="statsMini" style="font-size:12px; color:#aaa; font-weight:normal;">Caricamento...</span>
    </div>
    
    <div class="filters">
      <!-- Filtri Tracciati -->
      <button class="btn-filter active-blue" id="btnFilterTutto" onclick="setMode('TUTTO')">Tutte le Tracce</button>
      <button class="btn-filter" id="btnFilterTappe" onclick="setMode('TAPPE')">Solo Tappe</button>
      <button class="btn-filter" id="btnFilterGiri" onclick="setMode('GIRI')">Solo Giri</button>
      
      <div style="width:1px; background:#555; margin:0 5px;"></div>
      
      <!-- Filtri Paese -->
      <button class="btn-filter active" id="btnFilterMondo" onclick="setCountry('')">🌎 Mondo</button>
      <select id="selectCountry" class="btn-filter" style="background:#333; color:#ccc;" onchange="setCountry(this.value)">
        <option value="" disabled selected>Scegli Paese...</option>
      </select>
    </div>
  </div>

  <!-- MAPPA -->
  <div id="mapPub"></div>

  <!-- LIGHTBOX FOTO -->
  <div id="lightbox" onclick="closeLightbox()">
    <button id="lightboxClose" onclick="event.stopPropagation(); closeLightbox()">×</button>
    <img id="lightboxImg" onclick="event.stopPropagation();">
  </div>

<script>
  let DATA = null;
  let map = null;
  let layerTracce = null;
  let layerMarkers = null;

  let currentMode = 'TUTTO'; // TUTTO, TAPPE, GIRI
  let currentCountry = '';   // vuoto = Mondo

  // Inizializza Mappa
  function initMap() {
    map = L.map('mapPub', { zoomControl: false }).setView([4.7, -74.1], 5);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 19 }).addTo(map);
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    
    layerTracce = L.layerGroup().addTo(map);
    layerMarkers = L.layerGroup().addTo(map);
  }

  // Estrai ID Youtube
  function getYouTubeId(url) {
    if (!url) return null;
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
  }

  // Prepara Icone
  const iconFoto = L.divIcon({ className: 'custom-marker marker-foto', html: '📷' });
  const iconVideo = L.divIcon({ className: 'custom-marker marker-video', html: '▶️' });
  const iconMaint = L.divIcon({ className: 'custom-marker marker-maint', html: '🔧' });
  const iconFuel = L.divIcon({ className: 'custom-marker marker-fuel', html: '⛽' });
  const iconCarb = L.divIcon({ className: 'custom-marker marker-carb', html: '🌬️' });

  // Disegna Tracce e Marcatori
  function renderMap() {
    layerTracce.clearLayers();
    layerMarkers.clearLayers();

    if (!DATA) return;

    let bounds = L.latLngBounds();
    let drawnLines = 0;

    // 1. DISEGNA TRACCE (Tappe e Turismo)
    const tappe = Array.isArray(DATA.tappe) ? DATA.tappe : [];
    const turismo = Array.isArray(DATA.turismo) ? DATA.turismo : [];

    let tracceDaMostrare = [];
    if (currentMode === 'TUTTO' || currentMode === 'TAPPE') tracceDaMostrare.push(...tappe);
    if (currentMode === 'TUTTO' || currentMode === 'GIRI') tracceDaMostrare.push(...turismo);

    tracceDaMostrare.forEach(t => {
      // Filtro paese
      if (currentCountry && t.paese !== currentCountry) return;
      if (!t.traccia || t.traccia.length < 2) return;

      const latlngs = t.traccia.map(p => Array.isArray(p) ? [p[0], p[1]] : [p.lat, p.lon || p.lng]);
      const color = t.tipo === 'Turismo' ? '#2196F3' : '#d32f2f'; // Blu per giri, Rosso per tappe

      const poly = L.polyline(latlngs, { color: color, weight: 4, opacity: 0.8 }).addTo(layerTracce);
      bounds.extend(poly.getBounds());
      drawnLines++;

      // Popup sulla linea
      poly.bindPopup(`
        <div class="popup-title">${t.tipo || 'Percorso'} - ${t.paese}</div>
        <div class="popup-meta">📅 ${t.data} | 📏 ${t.km} km</div>
        <div>${t.note || ''}</div>
      `);
    });

    // 2. DISEGNA DIARIO (Foto e Video)
    const diario = Array.isArray(DATA.diario) ? DATA.diario : [];
    diario.forEach(d => {
      if (currentCountry && d.paese !== currentCountry) return;
      if (!d.geo || !isFinite(d.geo.lat) || !isFinite(d.geo.lon)) return;

      const ytId = getYouTubeId(d.videoUrl);
      const fotoSrc = d.fotoUrl || d.foto;

      let icon = ytId ? iconVideo : iconFoto;
      
      let mediaHtml = '';
      if (ytId) {
        mediaHtml = `<div class="popup-video"><iframe src="https://www.youtube.com/embed/${ytId}" allowfullscreen></iframe></div>`;
      } else if (fotoSrc) {
        mediaHtml = `<img class="popup-img" src="${fotoSrc}" onclick="openLightbox('${fotoSrc}')">`;
      }

      const m = L.marker([d.geo.lat, d.geo.lon], { icon: icon }).addTo(layerMarkers);
      bounds.extend(m.getLatLng());

      m.bindPopup(`
        <div class="popup-title">📍 ${d.paese || ''}</div>
        <div class="popup-meta">📅 ${d.data} ${d.ora} | 📏 km ${d.km}</div>
        <div>${d.testo || ''}</div>
        ${mediaHtml}
      `, { minWidth: 250 });
    });

    // Fit bounds se c'è qualcosa
    if (drawnLines > 0 || layerMarkers.getLayers().length > 0) {
      map.fitBounds(bounds.pad(0.1));
    }
  }

  // Gestione Bottoni Filtro
  function setMode(mode) {
    currentMode = mode;
    document.getElementById('btnFilterTutto').classList.remove('active-blue');
    document.getElementById('btnFilterTappe').classList.remove('active-blue');
    document.getElementById('btnFilterGiri').classList.remove('active-blue');
    
    if(mode === 'TUTTO') document.getElementById('btnFilterTutto').classList.add('active-blue');
    if(mode === 'TAPPE') document.getElementById('btnFilterTappe').classList.add('active-blue');
    if(mode === 'GIRI') document.getElementById('btnFilterGiri').classList.add('active-blue');
    
    renderMap();
  }

  function setCountry(country) {
    currentCountry = country;
    const btnMondo = document.getElementById('btnFilterMondo');
    const select = document.getElementById('selectCountry');

    if (country === '') {
      btnMondo.classList.add('active');
      select.classList.remove('active');
      select.value = "";
    } else {
      btnMondo.classList.remove('active');
      select.classList.add('active');
    }
    
    renderMap();
  }

  // Popola la select dei paesi
  function popolaPaesi() {
    const select = document.getElementById('selectCountry');
    if (!DATA || !DATA.datiPaesi) return;
    
    Object.keys(DATA.datiPaesi).forEach(p => {
      const opt = document.createElement('option');
      opt.value = p;
      opt.innerText = "📍 " + p;
      select.appendChild(opt);
    });
  }

  // Lightbox Foto
  function openLightbox(src) {
    document.getElementById('lightboxImg').src = src;
    document.getElementById('lightbox').classList.add('open');
  }
  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('open');
    document.getElementById('lightboxImg').src = '';
  }

  // Caricamento Dati
  async function loadData() {
    initMap();
    try {
      // Prova a caricare il file json esportato
      const urlParams = new URLSearchParams(window.location.search);
      const src = urlParams.get('src') || 'vespatrek_public.json';
      
      const res = await fetch(src);
      DATA = await res.json();

      document.getElementById('appTitle').innerText = DATA.titolo || 'VespaTrek Live 🌍';
      document.getElementById('statsMini').innerText = `Totale: ${DATA.stats.kmTotali} km | ${DATA.stats.benzinaUsataLitri.toFixed(1)} L Benzina`;

      popolaPaesi();
      renderMap();
    } catch (e) {
      document.getElementById('statsMini').innerText = 'Errore caricamento dati';
      console.error(e);
    }
  }

  window.onload = loadData;
</script>

</body>
</html>
